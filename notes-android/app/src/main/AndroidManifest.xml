<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Exactly one permission: the microphone, because voice notes are a
      first-class kind of entry here and not an attachment.

      Deliberately absent:
        INTERNET          the app never talks to anything. Not "does not"; cannot.
        CAMERA            taking a photo delegates to the camera app through
                          ACTION_IMAGE_CAPTURE. Declaring CAMERA would make the
                          permission mandatory rather than optional, and the
                          system camera app holds it already.
        WRITE_EXTERNAL_STORAGE / READ_MEDIA_IMAGES
                          photos are picked through ACTION_GET_CONTENT, where the
                          system grants read access to the one file the user chose,
                          and the backup is written through a save dialog the user
                          points at a folder. Neither needs a broad grant.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ hides other apps unless you say you are looking for them.
         Without this the camera is not offered as a source for a new photo. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The camera app writes the captured photo into our cache directory
             through this provider, which is what keeps the app free of the
             CAMERA and storage permissions. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
